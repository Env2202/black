{
  "manifest_version": 3,
  "name": "Astrix Desktop Layout",
  "version": "1.0.0",
  "description": "Reflows Astrix (astrix.elynn.me) phone-locked pages into a usable desktop layout.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Astrix Desktop Layout",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://astrix.elynn.me/*",
        "https://voice-connect-joy.lovable.app/*"
      ],
      "css": ["desktop.css"],
      "js": ["desktop.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://astrix.elynn.me/*",
    "https://voice-connect-joy.lovable.app/*"
  ]
}
